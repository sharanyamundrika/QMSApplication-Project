@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var module = Context.Request.Query["module"].ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Quality Management Portal</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
        }

        .portal-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .portal-sidebar {
            width: 250px;
            background-color: #123a72;
            color: white;
            padding: 20px 0;
            flex-shrink: 0;
        }

        /* Logo */
        .portal-logo {
            text-align: center;
            padding: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .logo-circle {
            width: 60px;
            height: 60px;
            margin: auto;
            border-radius: 50%;
            background-color: white;
            color: #123a72;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            font-weight: bold;
        }

        .portal-title {
            text-align: center;
            padding: 15px 10px;
            color: #ffd700;
            font-size: 16px;
            font-weight: bold;
        }

        .portal-menu a {
            display: block;
            padding: 14px 25px;
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

        .portal-menu a:hover {
            background-color: #1d4f91;
        }

       
        /* Main area */
        .portal-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* Header */
        .portal-header {
            height: 70px;
            background-color: white;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .user-name {
            margin-right: 20px;
            font-weight: bold;
            color: #123a72;
        }

        .logout {
            background-color: #123a72;
            color: white;
            padding: 9px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .logout:hover {
            background-color: #1d4f91;
        }

        /* Page content */
        .portal-content {
            flex: 1;
            padding: 40px;
        }

        /* Footer */
        .portal-footer {
            text-align: center;
            padding: 15px;
            background-color: white;
            color: #666;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <div class="portal-layout">

        <!-- Sidebar -->
        <aside class="portal-sidebar">

            <div class="portal-logo">
                <div class="logo-circle">
                    QMS
                </div>
            </div>

            <div class="portal-title">
                Quality Management Portal
            </div>

            <nav class="portal-menu">

                <a href="/Dashboard"
                   class="@(Context.Request.Path.Equals("/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    Dashboard
                </a>

                <a href="/MD"
                   class="@(currentPage == "/MD" ? "active" : "")">
                    M &amp; D
                </a>

                <a href="/ComingSoon?module=Reports"
                   class="@(currentPage == "/ComingSoon" && module == "Reports" ? "active" : "")">
                    Reports
                </a>

                <a href="/ComingSoon?module=MyTasks"
                   class="@(currentPage == "/ComingSoon" && module == "MyTasks" ? "active" : "")">
                    My Tasks
                </a>

                <a href="/ComingSoon?module=MyTeam"
                   class="@(currentPage == "/ComingSoon" && module == "MyTeam" ? "active" : "")">
                    My Team
                </a>

                <a href="/ComingSoon?module=Changes"
                   class="@(currentPage == "/ComingSoon" && module == "Changes" ? "active" : "")">
                    Changes
                </a>

                <a href="/ComingSoon?module=TimeSheets"
                   class="@(currentPage == "/ComingSoon" && module == "TimeSheets" ? "active" : "")">
                    Time Sheets
                </a>

                <a href="/ComingSoon?module=Settings"
                   class="@(currentPage == "/ComingSoon" && module == "Settings" ? "active" : "")">
                    Settings
                </a>

            </nav>

        </aside>

        <!-- Main -->
        <main class="portal-main">

            <!-- Header -->
            <header class="portal-header">

                <span class="user-name">
                    @Context.Session.GetString("LoggedInUser")
                </span>

                <form method="post" asp-page="/Dashboard" asp-page-handler="Logout">
                    <button type="submit" class="logout">
                        Logout
                    </button>
                </form>

            </header>

            <!-- Page Content -->
            <section class="portal-content">
                @RenderBody()
            </section>

            <!-- Footer -->
            <footer class="portal-footer">
                © 2026 i-ray IT Solutions. All rights reserved.
            </footer>

        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>