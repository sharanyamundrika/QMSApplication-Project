@page
@model QMSApplication.Pages.NotificationAdminModel

@{
    ViewData["Title"] = "Notification Management";
    Layout = "_PortalLayout";
}

<div style="padding:30px;">

    <h1>Notification Management</h1>

    <p>
        Admin and Manager notification management.
    </p>

    <a href="/NotificationCreate"
       style="display:inline-block;
        padding:10px 16px;
        background:#1f4e79;
        color:white;
        text-decoration:none;
        border-radius:5px;
        margin-bottom:20px;">
        + Create Notification
    </a>

    <hr />

    @if (Model.Notifications.Count == 0)
    {
        <p>No notifications found.</p>
    }
    else
    {
        <table style="width:100%;
            border-collapse:collapse;
            margin-top:20px;">

            <thead>
                <tr>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Title
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Priority
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Mandatory
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Published
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Read
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Acknowledged
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Date
                    </th>

                    <th style="border:1px solid #ddd;
                        padding:10px;">
                        Action
                    </th>

                </tr>
            </thead>

            <tbody>

                @foreach (var notification in Model.Notifications)
                {
                    <tr>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @notification.Title
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @notification.Priority
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @(notification.IsMandatory ? "Yes" : "No")
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @(notification.IsPublished ? "Yes" : "No")
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @(notification.IsRead
                                ? "Read"
                                : "Unread")
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @(notification.IsAcknowledged
                                ? "Acknowledged"
                                : "Not Acknowledged")
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;">
                            @notification.NotificationDateUtc
                            .ToLocalTime()
                            .ToString("dd-MMM-yyyy HH:mm")
                        </td>

                        <td style="border:1px solid #ddd;
                            padding:10px;
                            white-space:nowrap;">

                            <!-- Edit -->

                            <a href="/NotificationEdit?id=@notification.Id"
                               style="color:#123a72;
                                font-weight:bold;
                                text-decoration:none;
                                margin-right:12px;">
                                Edit
                            </a>

                            <!-- Delete -->

                            <form method="post"
                                  asp-page-handler="Delete"
                                  style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this notification?');">

                                <input type="hidden"
                                       name="id"
                                       value="@notification.Id" />

                                <button type="submit"
                                        style="background:#c62828;
                                    color:white;
                                    border:none;
                                    padding:6px 10px;
                                    border-radius:4px;
                                    cursor:pointer;">
                                    Delete
                                </button>

                            </form>

                            <!-- Publish / Unpublish -->

                            <form method="post"
                                  asp-page-handler="TogglePublish"
                                  style="display:inline;
                                margin-left:8px;">

                                <input type="hidden"
                                       name="id"
                                       value="@notification.Id" />

                                <button type="submit"
                                        style="background:@(notification.IsPublished ? "#777" : "#2e7d32");
                                    color:white;
                                    border:none;
                                    padding:6px 10px;
                                    border-radius:4px;
                                    cursor:pointer;">

                                    @(notification.IsPublished
                                        ? "Unpublish"
                                        : "Publish")

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>