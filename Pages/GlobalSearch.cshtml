@page
@model QMSApplication.Pages.GlobalSearchModel

@{
    ViewData["Title"] = "Global Search";
    Layout = "_PortalLayout";
}

<div style="padding:30px;">

    <h1>Global Search</h1>

    <form method="get" style="margin-bottom:25px;">

        <input type="text"
               name="Query"
               value="@Model.Query"
               placeholder="Search Milestone, Deliverable, Assigned To or Status"
               style="width:400px;
        padding:10px;
        border:1px solid #ccc;
        border-radius:5px;" />

        <button type="submit"
                style="padding:10px 18px;
            margin-left:5px;
            background:#123a72;
            color:white;
            border:none;
            border-radius:5px;">
            Search
        </button>

    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <h3>
            Search Results for:
            <strong>@Model.Query</strong>
        </h3>

        @if (Model.Results.Count == 0)
        {
            <p>No matching M &amp; D records found.</p>
        }
        else
        {
            <p>
                @Model.Results.Count matching record(s) found.
            </p>

            <table style="width:100%;
                border-collapse:collapse;
                margin-top:15px;">

                <thead>
                    <tr>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Record ID
                        </th>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Milestone Name
                        </th>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Deliverable Name
                        </th>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Assigned To
                        </th>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Status
                        </th>

                        <th style="border:1px solid #ddd; padding:10px;">
                            Action
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var record in Model.Results)
                    {
                        <tr>

                            <td style="border:1px solid #ddd; padding:10px;">
                                @record.RecordID
                            </td>

                            <td style="border:1px solid #ddd; padding:10px;">
                                @record.MilestoneName
                            </td>

                            <td style="border:1px solid #ddd; padding:10px;">
                                @record.DeliverableName
                            </td>

                            <td style="border:1px solid #ddd; padding:10px;">
                                @record.AssignedTo
                            </td>

                            <td style="border:1px solid #ddd; padding:10px;">
                                @record.Status
                            </td>

                            <td style="border:1px solid #ddd; padding:10px;">

                                <a href="/MDView?id=@record.Id"
                                   style="color:#123a72;
                                    font-weight:bold;
                                    text-decoration:none;">
                                    Open
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
    }

</div>