@page
@model QMSApplication.Pages.ImportUsersModel

@{
    ViewData["Title"] = "Import Users";
    Layout = "_PortalLayout";
}

<div style="padding:30px;">

    <h1>Import Users</h1>

    <p>
        This page imports users from Users.xlsx into MySQL.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div style="
            margin-top:20px;
            padding:15px;
            background:#e8f5e9;
            color:#2e7d32;
            border-radius:5px;">
            
            @Model.Message

        </div>
    }

</div>