@page
@model QMSApplication.Pages.NotificationCreateModel

@{
    ViewData["Title"] = "Create Notification";
    Layout = "_PortalLayout";
}

<div style="padding:30px; max-width:800px;">

    <h1>Create Notification</h1>

    <form method="post">

        <div style="margin-bottom:15px;">
            <label>Title</label><br />
            <input type="text"
                   name="Title"
                   style="width:100%; padding:8px;" />
        </div>

        <div style="margin-bottom:15px;">
            <label>Message</label><br />
            <textarea name="Message"
                      rows="5"
                      style="width:100%; padding:8px;"></textarea>
        </div>

        <div style="margin-bottom:15px;">
            <label>Priority</label><br />

            <select name="Priority"
                    style="width:100%; padding:8px;">

                <option value="Normal">Normal</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>

            </select>
        </div>

        <div style="margin-bottom:15px;">
            <label>
                <input type="checkbox"
                       name="IsMandatory"
                       value="true" />

                Mandatory notification
            </label>
        </div>

        <div style="margin-bottom:15px;">
            <label>
                <input type="checkbox"
                       name="IsPublished"
                       value="true" />

                Publish notification
            </label>
        </div>

        <div style="margin-bottom:15px;">
            <label>Target Role</label><br />

            <select name="TargetRole"
                    style="width:100%; padding:8px;">

                <option value="">All Users</option>
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="User">User</option>

            </select>
        </div>

        <button type="submit"
                style="padding:10px 18px;
            background:#1f4e79;
            color:white;
            border:none;
            border-radius:5px;">
            Save Notification
        </button>

        <a href="/NotificationAdmin"
           style="margin-left:10px;">
            Cancel
        </a>

    </form>

</div>